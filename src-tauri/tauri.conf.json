{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "menyala",
  "version": "0.1.0",
  "identifier": "com.giraty.menyala",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "menyala",
        "width": 1300,
        "height": 210,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["*/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/apps.json"]
  }
}
